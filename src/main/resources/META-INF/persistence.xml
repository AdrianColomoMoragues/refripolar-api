<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
    <persistence-unit name="ApiRefriPolarPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
        <class>com.refripolar.api.model.CategoriasProfesionales</class>
        <class>com.refripolar.api.model.Clientes</class>
        <class>com.refripolar.api.model.Empleados</class>
        <class>com.refripolar.api.model.Encargos</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <!-- Sin caché compartida: cada petición lee el estado real de la BD -->
        <shared-cache-mode>NONE</shared-cache-mode>
        <properties>
            <!-- URL, usuario y contraseña se inyectan desde variables de entorno (ver JpaUtil) -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <!-- El esquema lo crea db/init/01-bdrefripolar.sql; JPA no lo modifica -->
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
            <property name="eclipselink.logging.level" value="WARNING"/>
        </properties>
    </persistence-unit>
</persistence>
